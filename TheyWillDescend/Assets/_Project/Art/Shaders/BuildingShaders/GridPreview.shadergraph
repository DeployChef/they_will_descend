{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c1a2b3c4d5e6f708192a3b4c5d6e7f01",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GhostBand (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -520.0,
            "y": 1500.0,
            "width": 220.0,
            "height": 174.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "c1a2b3c4d5e6f708192a3b4c5d6e7f02"
        },
        {
            "m_Id": "c1a2b3c4d5e6f708192a3b4c5d6e7f31"
        },
        {
            "m_Id": "c1a2b3c4d5e6f708192a3b4c5d6e7f32"
        },
        {
            "m_Id": "c1a2b3c4d5e6f708192a3b4c5d6e7f33"
        },
        {
            "m_Id": "c1a2b3c4d5e6f708192a3b4c5d6e7f34"
        },
        {
            "m_Id": "c1a2b3c4d5e6f708192a3b4c5d6e7f03"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GhostBand",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 d = pos.xz - center.xz;\nfloat r = length(d);\nfloat theta = atan2(d.x, d.y);\nfloat dt = theta - band.z;\ndt -= round(dt / 6.28318531f) * 6.28318531f;\nfloat a = abs(dt);\nfloat fr = max(feather.x, 1e-4);\nfloat ft = max(feather.y, 1e-4);\nfloat bandR = saturate(min(r - band.x, band.y - r) / fr);\nfloat bandT = saturate((band.w - a) * max(r, 1e-4) / ft);\nfloat hr = max(feather.z, 1e-4);\nfloat ht = max(feather.w, 1e-4);\nfloat holeR = min(r - hole.x, hole.y - r);\nfloat holeT = (hole.w - a) * max(r, 1e-4);\nfloat holeMask = 1.0 - saturate(min(holeR / hr, holeT / ht));\nmask = min(bandR, bandT) * holeMask;"
}

