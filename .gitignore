# ── FMOD Studio ─────────────────────────────────────────────
# FMOD Studio project lives at: Audio_FMOD/they will desend/

# FMOD Studio per-user state (window layout, local settings, etc.)
# Regenerated per machine — never commit.
Audio_FMOD/**/.user/
Audio_FMOD/**/.cache/
Audio_FMOD/**/Cache/
Audio_FMOD/**/*.cache
Audio_FMOD/**/*.cache.meta
*.fspro.user
*.fmod.user

# FMOD Unity editor cache (event/bank refs) — rebuilt from banks in Editor.
TheyWillDescend/Assets/Plugins/FMOD/Cache/
TheyWillDescend/Assets/Plugins/FMOD/Cache.meta

# FMOD Studio build output IS committed.
# FMODStudioSettings.asset has sourceBankPath = ../Audio_FMOD/they will desend/Build/Desktop
# and HasPlatforms = 0, so Play-in-Editor and the Event Browser read banks from here.
# Without it a fresh clone has no banks in the editor.
#   Audio_FMOD/they will desend/Build/Desktop/*.bank

# Runtime copy (Build/Desktop/ → StreamingAssets/) is also committed:
#   TheyWillDescend/Assets/StreamingAssets/Desktop/*.bank
#   TheyWillDescend/Assets/StreamingAssets/Desktop/*.strings.bank

# Koda AI Rules (personal instructions, do not commit)
