# Git LFS — large binary audio assets

# FMOD Studio source audio
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text
*.wma   filter=lfs diff=lfs merge=lfs -text

# FMOD compiled banks (committed to repo for everyone without FMOD Studio)
*.bank  filter=lfs diff=lfs merge=lfs -text
*.strings.bank filter=lfs diff=lfs merge=lfs -text

# FMOD project files (text XML — no LFS needed)
# *.fsproj, *.xml are small text files, tracked normally by Git
